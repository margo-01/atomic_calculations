function  f = fx_fe_plot(dir)
% provide the directory as '/my/dir'

%
a_0 = 0.529177210544;


recip_grid = linspace(0,52.917720860738790, 2001).*1.889/(2*pi);
fx_ae = load(fullfile(dir, 'recip_iam_radial_charge.out'))
fx_core = load(fullfile(dir, 'recip_core_radial_charge.out'))
fx_val = load(fullfile(dir, 'recip_val_radial_charge.out'))
rho_ae = load(fullfile(dir,'rho_ae.out'));
rho_core = load(fullfile(dir,'rho_core.out'));
rho_val = load(fullfile(dir,'rho_val.out'));


Z = trapz(rho_ae(:,1), rho_ae(:,2));
Z_core = trapz(rho_core(:,1), rho_core(:,2));
Z_val = trapz(rho_val(:,1), rho_val(:,2));

figure(1)

box on
hold on
plot(recip_grid, fx_core, 'b-', 'LineWidth', 2)
plot(recip_grid, fx_val, 'r-', 'LineWidth', 2)
plot(recip_grid, fx_ae, 'Color',[128, 0, 128] / 255 ,'LineWidth', 2)

legend('core', 'valence', 'all-electron', 'FontSize', 14)
legend boxoff
ylim([0, (Z+1)])
xlim([0, 6])
saveas(gcf, fullfile(dir, 'fx_plot.png'))





r2_mean_ae = (trapz(rho_ae(:,1), rho_ae(:,1).^2 .* rho_ae(:,2)))./(trapz(rho_ae(:,1), rho_ae(:,2)));
r2_mean_core = (trapz(rho_core(:,1), rho_core(:,1).^2 .* rho_core(:,2)))./(trapz(rho_core(:,1), rho_core(:,2)));
r2_mean_val = (trapz(rho_val(:,1), rho_val(:,1).^2 .* rho_val(:,2)))./(trapz(rho_val(:,1), rho_val(:,2)));


fe_ae = mott_bethe(recip_grid, fx_ae, Z);
fe_ae(1) = fe_ae(2)%(1/3*a_0)* Z * r2_mean_ae;
%fe_ae = [interp1(recip_grid(2:end), fe_ae, recip_grid(1,1), 'next', 'extrap'), fe_ae]%(1/3*a_0)* Z * r2_mean_ae;

fe_core = mott_bethe(recip_grid, fx_core, Z_core);
fe_core(1) = fe_core(2)%(1/3*a_0)* Z_core * r2_mean_core;
%fe_core = [interp1(recip_grid(2:end), fe_core, recip_grid(1,1), 'next', 'extrap'), fe_core]%(1/3*a_0)* Z_core * r2_mean_core;

fe_val = mott_bethe(recip_grid, fx_val, Z_val);
fe_val(1) = fe_val(2)%(1/3*a_0)* Z_val * r2_mean_val;
%fe_val = [interp1(recip_grid(2:end), fe_val, recip_grid(1,1),'next', 'extrap' ), fe_val]%(1/3*a_0)* Z_val * r2_mean_val;

figure(2)

box on
hold on
plot(recip_grid, fe_core, 'b-', 'LineWidth', 2)
plot(recip_grid, fe_val, 'r-', 'LineWidth', 2)
plot(recip_grid, fe_ae, 'Color',[128, 0, 128] / 255 ,'LineWidth', 2)

xlim([0, 3])

legend('core', 'val','all-electron', 'FontSize', 14)
legend boxoff
saveas(gcf, fullfile(dir, 'fe_plot.png'))

fe_ae_out = [recip_grid' fe_ae'];
fe_val_out = [recip_grid' fe_val'];
fe_core_out = [recip_grid' fe_core'];

save(fullfile(dir,'fe_ae.xy'), 'fe_ae_out',"-ascii")
save(fullfile(dir,'fe_val.xy'), 'fe_val_out',"-ascii")
save(fullfile(dir,'fe_core.xy'), 'fe_core_out',"-ascii")
end
